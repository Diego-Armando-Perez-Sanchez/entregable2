<main class="ventana">
    <header class="barra-superior">
        <div class="marca">
            <span class="marca-icono" aria-hidden="true">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 11a8 8 0 0 1-8 8H7l-4 3V7a4 4 0 0 1 4-4h9a4 4 0 0 1 4 4Z"></path><path d="M7 8h9M7 12h6"></path>
                </svg>
            </span>
            <span>HOLA,<br>MENSAJES.</span>
        </div>
        <p class="lema-cabecera">UN ESPACIO PARA DECIRLO.</p>
        <button class="control-movimiento" type="button" data-pausar aria-pressed="false" hidden>
            <span data-icono-pausa aria-hidden="true">Ⅱ</span>
            <span data-texto-pausa>Pausar movimiento</span>
        </button>
    </header>

    <div class="escenario">
        <div class="sticker" aria-hidden="true"><span>TU VOZ<br>CUENTA</span><span class="sticker-estrella">✳</span></div>
        <div class="cinta" aria-hidden="true">
            <div class="cinta-track">
                <span>MENOS SILENCIO. MÁS IDEAS. ✳&nbsp; MENOS SILENCIO. MÁS IDEAS. ✳&nbsp; MENOS SILENCIO. MÁS IDEAS. ✳&nbsp; MENOS SILENCIO. MÁS IDEAS. ✳&nbsp;</span><span>MENOS SILENCIO. MÁS IDEAS. ✳&nbsp; MENOS SILENCIO. MÁS IDEAS. ✳&nbsp; MENOS SILENCIO. MÁS IDEAS. ✳&nbsp; MENOS SILENCIO. MÁS IDEAS. ✳&nbsp;</span>
            </div>
        </div>

        <section class="conversacion" aria-labelledby="titulo-mensajes">
            <header class="cabecera-conversacion">
                <div class="titulo-bandeja"><span class="punto-bandeja" aria-hidden="true"></span><h2 id="titulo-mensajes">CAJA DE MENSAJES</h2></div>
                <p class="usuario"><span>USERNAME</span><strong>{{username}}</strong></p>
            </header>

            <div class="compositor">
                <form class="formulario" action="/mensajes" method="POST">
                    <label for="mensaje">¿QUÉ QUIERES DECIR?</label>
                    <div class="fila-formulario">
                        <input type="text" id="mensaje" name="mensaje" placeholder="{{placeholder}}" value="{{cajaTexto}}" maxlength="500" required aria-describedby="ayuda-mensaje{{#if error}} error-mensaje{{/if}}" {{#if error}}aria-invalid="true"{{/if}}>
                        <button class="boton-enviar" type="submit"><span>ENVIAR</span><span class="boton-flecha" aria-hidden="true">↗</span></button>
                    </div>
                    <div class="ayuda-formulario"><p id="ayuda-mensaje">Hasta 500 caracteres. Enter para enviar.</p><span data-caracteres aria-hidden="true">0 / 500</span></div>
                </form>
                <p class="error" id="error-mensaje" role="alert" {{#unless error}}hidden{{/unless}}>{{error}}</p>
            </div>

            <div class="separador-mensajes"><span>EN ESTA CONVERSACIÓN</span><span class="contador"><span data-total-mensajes>{{cajaMensajes.length}}</span> MENSAJES</span></div>
            <div class="caja-mensajes" role="region" aria-label="Lista de mensajes" tabindex="0">
                {{#if cajaMensajes.length}}
                    <ol class="mensajes">
                        {{#each cajaMensajes}}
                            <li class="mensaje{{#if @last}} mensaje-nuevo{{/if}}">
                                <span class="mensaje-avatar" aria-hidden="true">{{this.numero}}</span>
                                <div class="mensaje-contenido"><strong class="mensaje-titulo">MENSAJE {{this.numero}}</strong><p>{{this.texto}}</p></div>
                            </li>
                        {{/each}}
                    </ol>
                {{else}}
                    <div class="sin-mensajes">
                        <div class="ilustracion-vacia" aria-hidden="true"><span class="mini-estrella">✳</span><div class="burbuja-vacia"><span></span><span></span><span></span></div><span class="saludo-vacio">¡HOLA!</span></div>
                        <p>AQUÍ FALTA TU<br>PRIMERA IDEA.</p>
                        <span>Escribe arriba. Tu mensaje aparecerá aquí abajo.</span>
                    </div>
                {{/if}}
            </div>
            <footer class="pie-conversacion"><span class="indicador-estado" aria-hidden="true"></span><p class="estado-formulario" role="status" aria-live="polite">{{#if cajaMensajes.length}}Tus mensajes están aquí.{{else}}Todo listo para tu primer mensaje.{{/if}}</p><span class="estrella-pie" aria-hidden="true">✳</span></footer>
        </section>
    </div>
    <footer class="pie-pagina"><span>01 / ESPACIO DE MENSAJES</span><span>LO IMPORTANTE ES EXPRESARTE. <span aria-hidden="true">↗</span></span></footer>
</main>
